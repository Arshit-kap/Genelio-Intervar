DJANGO_SECRET_KEY=replace-me-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (runs in Docker; Django on the host talks to localhost:5432)
DATABASE_URL=postgres://genelio:genelio@localhost:5432/genelio

# Consumed by the Postgres container
POSTGRES_DB=genelio
POSTGRES_USER=genelio
POSTGRES_PASSWORD=genelio

# pgAdmin (http://localhost:5050)
PGADMIN_EMAIL=admin@genelio.local
PGADMIN_PASSWORD=admin

# CORS / CSRF origins (frontend urls)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# LLM (for gut-microbiome chat)
VLLM_BASE_URL=http://localhost:8011/v1
MODEL_NAME=qwen3-30b
EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5

# Redis (Franklin cache + Celery broker for report enrichment).
# Bring up the local container with `docker compose up -d redis`.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
