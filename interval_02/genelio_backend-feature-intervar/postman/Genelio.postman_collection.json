{
  "info": {
    "name": "Genelio API",
    "description": "End-to-end user flow for the Genelio Django backend.\n\n### How to use\n1. Import this collection and the companion environment file (`Genelio.postman_environment.json`).\n2. Set the environment active.\n3. Run the requests top-to-bottom, or hit **Runner → Run Genelio API**.\n\nEach request has Tests that extract the IDs / tokens it produces and stash them in environment variables, so later requests automatically pick up the right values (`access_token`, `refresh_token`, `report_id`, `session_id`).\n\n### Base URLs\n- Local docker: `http://localhost:8000`\n- Production mirror: `https://ai-api.genelio.com`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "genelio-collection-0001"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000"},
    {"key": "email", "value": "demo+{{$timestamp}}@example.com"},
    {"key": "password", "value": "Sup3rSecret!"},
    {"key": "first_name", "value": "Demo"},
    {"key": "last_name", "value": "User"}
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "auth": {"type": "noauth"},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"first_name\": \"{{first_name}}\",\n  \"last_name\": \"{{last_name}}\",\n  \"password\": \"{{password}}\",\n  \"re_password\": \"{{password}}\",\n  \"agreed_to_terms\": true\n}"
            },
            "url": {"raw": "{{base_url}}/auth/users/", "host": ["{{base_url}}"], "path": ["auth", "users", ""]}
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Always generate a fresh email so re-runs don't collide with an existing account.",
                  "pm.environment.set('email', `demo+${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('user_id', body.id);",
                  "  // Keep the canonical (server-normalised) email for the login step.",
                  "  pm.environment.set('email', body.email);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (JWT create)",
          "request": {
            "auth": {"type": "noauth"},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {"raw": "{{base_url}}/auth/jwt/create/", "host": ["{{base_url}}"], "path": ["auth", "jwt", "create", ""]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.environment.set('access_token', body.access);",
                  "pm.environment.set('refresh_token', body.refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get /auth/users/me/",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/auth/users/me/", "host": ["{{base_url}}"], "path": ["auth", "users", "me", ""]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Returns email', () => pm.expect(pm.response.json()).to.have.property('email'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo_{{$randomInt}}\",\n  \"first_name\": \"Demo\",\n  \"last_name\": \"User\"\n}"
            },
            "url": {"raw": "{{base_url}}/auth/users/me/", "host": ["{{base_url}}"], "path": ["auth", "users", "me", ""]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "auth": {"type": "noauth"},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {"raw": "{{base_url}}/auth/jwt/refresh/", "host": ["{{base_url}}"], "path": ["auth", "jwt", "refresh", ""]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.environment.set('access_token', pm.response.json().access);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Reports",
      "item": [
        {
          "name": "List report types",
          "request": {
            "auth": {"type": "noauth"},
            "method": "GET",
            "url": {"raw": "{{base_url}}/chatbot/report/types/", "host": ["{{base_url}}"], "path": ["chatbot", "report", "types", ""]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Six report types present', () => {",
                  "  const values = pm.response.json().map(t => t.value).sort();",
                  "  pm.expect(values).to.deep.equal(['gut','oral','skin','vaginal','wes','wgs']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload report (stub type — WES)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "report_type", "value": "wes", "type": "text"},
                {
                  "key": "file",
                  "type": "file",
                  "src": "fixtures/sample.pdf",
                  "description": "Any PDF. The Newman run ships with postman/fixtures/sample.pdf."
                }
              ]
            },
            "url": {"raw": "{{base_url}}/chatbot/report/data/", "host": ["{{base_url}}"], "path": ["chatbot", "report", "data", ""]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.environment.set('report_id', body.id);",
                  "pm.test('Stub analyzer marked ready', () => {",
                  "  pm.expect(body.status).to.eql('ready');",
                  "  pm.expect(body.parsed_data.status).to.eql('stub');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List my reports (paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/chatbot/report/data/?page=1",
              "host": ["{{base_url}}"],
              "path": ["chatbot", "report", "data", ""],
              "query": [{"key": "page", "value": "1"}]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Has count + results', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.have.property('count');",
                  "  pm.expect(b.results).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter reports by type",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/chatbot/report/data/?report_type=wes",
              "host": ["{{base_url}}"],
              "path": ["chatbot", "report", "data", ""],
              "query": [{"key": "report_type", "value": "wes"}]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Every row is wes', () => {",
                  "  pm.response.json().results.forEach(r => pm.expect(r.report_type).to.eql('wes'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get report detail",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/chatbot/report/data/{{report_id}}/", "host": ["{{base_url}}"], "path": ["chatbot", "report", "data", "{{report_id}}", ""]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Parsed data present', () => pm.expect(pm.response.json()).to.have.property('parsed_data'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Chat",
      "item": [
        {
          "name": "Create chat session (linked to report)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My first chat\",\n  \"report_id\": \"{{report_id}}\"\n}"
            },
            "url": {"raw": "{{base_url}}/chatbot/chat/session/list/", "host": ["{{base_url}}"], "path": ["chatbot", "chat", "session", "list", ""]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.environment.set('session_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List chat sessions",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/chatbot/chat/session/list/", "host": ["{{base_url}}"], "path": ["chatbot", "chat", "session", "list", ""]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Has results', () => pm.expect(pm.response.json().results).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Send message",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Hello Genelio, is my gut healthy?\"\n}"
            },
            "url": {"raw": "{{base_url}}/chatbot/chat/session/{{session_id}}/send/", "host": ["{{base_url}}"], "path": ["chatbot", "chat", "session", "{{session_id}}", "send", ""]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('Returns user + assistant', () => {",
                  "  pm.expect(b.user.role).to.eql('user');",
                  "  pm.expect(b.assistant.role).to.eql('assistant');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get session with messages",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/chatbot/chat/session/{{session_id}}/", "host": ["{{base_url}}"], "path": ["chatbot", "chat", "session", "{{session_id}}", ""]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Has >= 2 messages', () => pm.expect(pm.response.json().message_count).to.be.at.least(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rename session",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"title\": \"Renamed session\"\n}"},
            "url": {"raw": "{{base_url}}/chatbot/chat/session/{{session_id}}/", "host": ["{{base_url}}"], "path": ["chatbot", "chat", "session", "{{session_id}}", ""]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Cleanup",
      "item": [
        {
          "name": "Delete chat session",
          "request": {
            "method": "DELETE",
            "url": {"raw": "{{base_url}}/chatbot/chat/session/{{session_id}}/", "host": ["{{base_url}}"], "path": ["chatbot", "chat", "session", "{{session_id}}", ""]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        },
        {
          "name": "Delete report",
          "request": {
            "method": "DELETE",
            "url": {"raw": "{{base_url}}/chatbot/report/data/{{report_id}}/", "host": ["{{base_url}}"], "path": ["chatbot", "report", "data", "{{report_id}}", ""]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
