# ── Genelio InterVar — MedGemma-27B backend configuration ────────────────────
# Copy this file to .env and fill in real values
# NEVER commit .env with real secrets

# ── LLM backend ───────────────────────────────────────────────────────────────
# MedGemma is served via vLLM on the MedGemma server (213.181.122.239)
# Access it through the SSH tunnel forwarded to localhost:8030
LLM_BACKEND=vllm_api
VLLM_API_URL=http://localhost:8030
VLLM_MODEL=medgemma-27b

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite patient variants database (76,330 InterVar-annotated WGS variants)
SQLALCHEMY_DATABASE_URL=sqlite:///patient_variants.db

# ── HuggingFace (optional — for local model fallback) ─────────────────────────
# Only needed if you want HF Inference API as a fallback
# HF_TOKEN=hf_your_token_here
HF_HOME=/ephemeral/hf

# ── Server configuration ──────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
