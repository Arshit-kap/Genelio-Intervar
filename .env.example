# ── Genelio InterVar — Qwen3-32B backend configuration ───────────────────────
# Copy this file to .env and fill in real values
# NEVER commit .env with real secrets

# ── LLM backend ───────────────────────────────────────────────────────────────
# Qwen3-32B is served locally via Ollama (default port 11434)
# Start Ollama first: ollama serve   then   ollama pull qwen3:32b
LLM_BACKEND=vllm_api
VLLM_API_URL=http://localhost:11434
VLLM_MODEL=qwen3:32b

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite patient variants database (76,330 InterVar-annotated WGS variants)
SQLALCHEMY_DATABASE_URL=sqlite:///patient_variants.db

# ── HuggingFace (optional — for HF Inference API fallback) ────────────────────
# HF_TOKEN=hf_your_token_here
HF_HOME=/ephemeral/hf

# ── Server configuration ──────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8001
