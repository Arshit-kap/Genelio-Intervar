# ── Genelio Environment Configuration ────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it contains secrets.

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite patient variant database (created by ingest_new_db.py)
SQLALCHEMY_DATABASE_URL=sqlite:///patient_variants.db

# ── LLM Backend ───────────────────────────────────────────────────────────────
# Choose ONE option below:

# Option A — Ollama local (recommended for GPU servers, best quality)
#   Install: https://ollama.ai  then: ollama pull qwen3:32b
LLM_BACKEND=vllm_api
VLLM_API_URL=http://localhost:11434
VLLM_MODEL=qwen3:32b

# Option B — HuggingFace Inference API (no GPU, free ~1000 req/day)
#   Get token: https://huggingface.co/settings/tokens
# LLM_BACKEND=hf_api
# HF_TOKEN=hf_your_token_here
# HF_MODEL=Qwen/Qwen3-8B

# Option C — No LLM (pattern SQL only, no plain-English explanations)
# LLM_BACKEND=mock

# ── Ingestion settings ────────────────────────────────────────────────────────
BATCH_SIZE=1000
VALIDATE_ON_INSERT=true
SKIP_INVALID_ROWS=false

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
